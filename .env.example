# Phase 1 - Ollama & Model Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120

# Phase 2 - Kafka Event Backbone
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INTERACTIONS=interaction.events
KAFKA_CONSUMER_GROUP=behavior-analyzer
KAFKA_ENABLED=true

# Phase 2 - Local Storage
SQLITE_DB_PATH=data/user.db

# Phase 2 - Interest Scoring & Recency Weights
INTEREST_FREQUENCY_WEIGHT=0.35
INTEREST_RECENCY_WEIGHT=0.35
INTEREST_ENGAGEMENT_WEIGHT=0.20
INTEREST_FEEDBACK_WEIGHT=0.10
INTEREST_DECAY_RATE=0.95

# Phase 3 - Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=60

# Phase 3 - Model Router Configuration
LOCAL_MIN_SUITABILITY=0.70
LOCAL_MIN_CONFIDENCE=0.65
LOCAL_MAX_CONTEXT_CHARS=6000
ROUTER_FALLBACK_TO_LOCAL=true
