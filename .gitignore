# Environment & secrets
.env
.env.local
.env.*

# Python virtualenvs & cache
venv/
backend/venv/
**/__pycache__/
__pycache__/
**/.pytest_cache/
.pytest_cache/
*.pyc

# Local LLM weights
models/

# macOS metadata
.DS_Store
**/.DS_Store

# Local SQLite databases (WAL / SHM)
*.db
*.db-wal
*.db-shm
data/*.db
data/*.db-wal
data/*.db-shm

# Event spool & exports (keep directory structure)
data/events/*
!data/events/.gitkeep
data/exports/*
!data/exports/.gitkeep

# Training datasets & bundles
data/training/**
!data/training/
!data/training/.gitkeep

# Google Drive & Cloud sync staging
data/google_drive_sync/**
!data/google_drive_sync/
!data/google_drive_sync/.gitkeep
data/cloud_sync_staging/**
!data/cloud_sync_staging/
!data/cloud_sync_staging/.gitkeep
data/postgres_sync_state.json
data/*.json

# Evaluation reports

evaluation/reports/*
!evaluation/reports/.gitkeep

# Archives and backups
*.zip
*.tar.gz



